if ZMK_BLE

if ZMK_SPLIT_BLE

config ZMK_SPLIT_BLE_PRIORITY
    default 1

# A switchable half needs bond storage for both roles at once: the host
# profiles and split-peripheral bond it uses as a central, plus the bond(s)
# it uses as a peripheral after switching. Placed before the plain
# ZMK_SPLIT_ROLE_CENTRAL_CAPABLE default below so it wins when both apply.
config BT_MAX_PAIRED
    default 7 if ZMK_SPLIT_ROLE_SWITCHABLE

config BT_ID_MAX
    default 2 if ZMK_SPLIT_ROLE_SWITCHABLE

if ZMK_SPLIT_ROLE_CENTRAL_CAPABLE

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 1

config BT_MAX_CONN
    default 6

config BT_MAX_PAIRED
    default 6

#ZMK_SPLIT_BLE && ZMK_SPLIT_ROLE_CENTRAL_CAPABLE
endif

endif

if !ZMK_SPLIT_BLE

config BT_MAX_CONN
    default 5

config BT_MAX_PAIRED
    default 5

#!ZMK_SPLIT_BLE
endif

#ZMK_BLE
endif

