#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/split_role.h>

&kscan {
    /delete-property/ exit-after;
    events =
    <ZMK_MOCK_PRESS(0,0,3000)
    ZMK_MOCK_RELEASE(0,0,200)
    ZMK_MOCK_PRESS(1,1,2000)
    ZMK_MOCK_RELEASE(1,1,200)>;
};
/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &split_role SPLIT_ROLE_CENTRAL    &kp B
            &kp C                             &split_role SPLIT_ROLE_PERIPHERAL>;
        };
    };
};
